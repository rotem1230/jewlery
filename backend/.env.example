# Malinvosky API configuration. Values below are for LOCAL DEVELOPMENT.
# In production the API refuses to boot with unsafe values (see docs/production-readiness.md);
# entries marked [prod: required] must be set explicitly there.

# ─── Application ─────────────────────────────────────────────────────────────────────────────────
# development | test | production (required: an unset value is refused)
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_TIMEZONE=Asia/Jerusalem
# [prod: required] Public https URL of this API; e-mailed verify/reset links point at pages it hosts.
API_PUBLIC_URL=http://localhost:3000
# [prod: required] Proxies in front of the API: a hop count (e.g. 1), their addresses, or false when
# exposed directly. Never "true" (clients could choose their own IP and dodge rate limits).
TRUST_PROXY=false
# [prod: required] Comma-separated https origins of web clients. No default in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
BODY_SIZE_LIMIT=1048576

# ─── Database / cache ────────────────────────────────────────────────────────────────────────────
# The PostgreSQL server should run in UTC (Prisma stores DateTime as UTC wall-clock time).
DATABASE_URL=postgresql://mailnvosky:mailnvosky@localhost:5433/mailnvosky?schema=public
# Strongly recommended in production, required with more than one API instance (shared rate limits,
# config cache). Leave empty to run without Redis.
REDIS_URL=redis://localhost:6380

# ─── Auth ────────────────────────────────────────────────────────────────────────────────────────
# [prod: required] At least 32 random characters, never one of the published example values.
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# bcrypt cost: 10..15 in production (default 12)
BCRYPT_ROUNDS=12
REGISTRATION_OPEN=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
# Per client (IP + e-mail) sign-in attempts per window, and mail-sending requests per client.
AUTH_LOGIN_THROTTLE_LIMIT=5
AUTH_LOGIN_THROTTLE_WINDOW_MS=900000
AUTH_MAIL_THROTTLE_LIMIT=10
AUTH_MAIL_THROTTLE_WINDOW_MS=3600000
AUTH_MAILS_PER_ACCOUNT_PER_HOUR=3
# Fallbacks used only when the AppConfig `token_ttls` / `password_policy` rows are absent
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_NUMBER=true
# Google / Apple sign-in: comma-separated client ids accepted as token audiences. Empty = disabled.
# Google: list the web client id AND the Android and iOS client ids (native tokens carry the web id
# as audience and the app's own id as authorized party).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ─── Mail ────────────────────────────────────────────────────────────────────────────────────────
MAIL_FROM=no-reply@mailnvosky.local
# [prod: required] SMTP URL (smtps://user:pass@host:465). Unset in development: mail is logged.
SMTP_URL=

# ─── Media ───────────────────────────────────────────────────────────────────────────────────────
# Where uploaded and generated files are kept: "database" (the upload_blobs table; survives deploys
# and restarts of hosts without a persistent disk, e.g. Render free tier) or "local" (uploads-local/
# on this machine's disk). Empty = database when NODE_ENV=production, local otherwise. Files written
# earlier are always read from where they were stored, so switching keeps existing files working
# (local ones only while their disk does). Database storage counts toward the database's size quota.
STORAGE_DRIVER=
# Design pictures are rendered in the background after each save (off in the e2e suites).
DESIGN_PREVIEWS=on
# How long POST /render-jobs waits for the file before answering with a job still running, which
# the app then polls (ms). Keep it well under the app's 30 s request timeout.
RENDER_SYNC_WAIT_MS=8000
S3_BUCKET=local-dev
S3_ENDPOINT=
# Key for signed media URLs (>= 32 chars). Derived from JWT_SECRET when empty.
UPLOAD_URL_SECRET=
UPLOAD_SIGNED_URL_TTL_SECONDS=900
# Media downloads per client IP per THROTTLE_TTL_MS (separate from the API budget). Users behind one
# carrier NAT share it: put a CDN in front of media rather than lowering it.
MEDIA_THROTTLE_LIMIT=600

# ─── Payments & subscriptions ────────────────────────────────────────────────────────────────────
# "mock" = fake provider for local development only (refused in production). Empty = payments
# fail closed (503) until a real provider integration exists.
PAYMENTS_PROVIDER=mock
# HMAC secret shared with the payment provider for webhook signatures (>= 32 chars). Empty = the
# webhook endpoint answers 503.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_SECRET_KEY=
# Key for trial bookkeeping hashes (one trial per mailbox; >= 32 chars). Required in production;
# elsewhere derived from JWT_SECRET when empty. Changing it forgets which mailboxes had a trial.
TRIAL_HASH_SECRET=
# Design requests one designer may send per 24 h, jewelers one broadcast reaches, and lead overage
# charges per subscription within one billing cycle (rolling).
DESIGN_REQUESTS_PER_DAY=20
ATELIER_BROADCAST_FANOUT=50
# Try-on jobs one user may start per 24 h.
VISUALIZATION_JOBS_PER_DAY=20
LEAD_OVERAGE_CAP=50

# ─── Optional vendor adapters ────────────────────────────────────────────────────────────────────
# Google Gemini (AI inspiration pictures: from the note, and from the inspiration picture when there
# is one). Key from https://aistudio.google.com/apikey, on a project with billing enabled (image
# models have no free tier). Unset: AI inspiration answers 503 AI_NOT_CONFIGURED (no stand-in picture).
GEMINI_API_KEY=
# Image model. Empty = gemini-3.1-flash-image (about $0.07 per picture); gemini-3-pro-image is the
# premium model, gemini-3.1-flash-lite-image the cheapest.
GEMINI_IMAGE_MODEL=
# Remote render engine. Unset: local PNG/STL files are written.
RENDER_ENGINE_URL=

# ─── Background jobs, limits, logging ────────────────────────────────────────────────────────────
JOBS_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=debug
LOG_REQUESTS=true

# ─── Seed ────────────────────────────────────────────────────────────────────────────────────────
# true = also seed demo accounts / showcase data (local development only; refused in production)
SEED_DEMO_DATA=true
