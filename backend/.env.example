# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_TIMEZONE=Asia/Jerusalem
# Public web/app URL used to build verify-email and reset-password links
APP_URL=http://localhost:8081

# Comma-separated origins (no * when credentials=true)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

BODY_SIZE_LIMIT=1048576

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://mailnvosky:mailnvosky@localhost:5433/mailnvosky?schema=public

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Object storage (uploads) ─────────────────────────────────
S3_BUCKET=local-dev
# Leave unset to use the built-in local-dev fake presign stub
S3_ENDPOINT=

# ─── Mail ────────────────────────────────────────────────────
MAIL_FROM=no-reply@mailnvosky.local
# Optional SMTP URL (smtp://user:pass@host:587). When unset, mail is logged.
SMTP_URL=

# ─── Optional vendor adapters ────────────────────────────────
# Tripo text-to-GLB (Inspiration tab only). When unset, dummy catalog GLB is copied into Uploads.
TRIPO_API_KEY=
# Optional remote render engine. When unset, local PNG/STL files are written into Uploads.
RENDER_ENGINE_URL=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
STRIPE_SECRET_KEY=

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REGISTRATION_OPEN=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Fallbacks used only when the AppConfig `token_ttls` / `password_policy` rows are absent
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_NUMBER=true

# ─── Rate limiting ───────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_REQUESTS=true
